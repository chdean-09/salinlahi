  m_Script: {fileID: 11500000, guid: 38eca7172864c470fb6cd1ee26d93838, type: 3}
  m_Name: Dialogue_Ugat05_Intro
  m_EditorClassIdentifier: Salinlahi.Runtime::DialogueSO
  lines:
  - speakerName: Tagapagsalaysay
    portrait: {fileID: 0}
    text: "Sa dulo ng Ugat, hinarap ni Juan ang Paglimot \u2014 ang anino na kumain
      sa mga alaala ng kanyang pamilya."
  - speakerName: Juan
    portrait: {fileID: 0}
    text: Iba na ang panahon. Iba na ang mundo. Ngunit hindi ibig sabihin niyon ay
      wala na akong natira.
  - speakerName: Tagapagsalaysay
    portrait: {fileID: 0}
    text: Tama ka, Juan. May mana kang hindi kayang kainin ng Paglimot. Bakasin mo
      ang IBA at ang MANA.
