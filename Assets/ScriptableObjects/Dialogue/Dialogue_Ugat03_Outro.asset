  m_Name: Dialogue_Ugat03_Outro
  m_EditorClassIdentifier: Salinlahi.Runtime::DialogueSO
  lines:
  - speakerName: Juan
    portrait: {fileID: 0}
    text: '"Tama ang bata." Iyon ang sinabi ni Ama sa akin.'
  - speakerName: Tagapagsalaysay
    portrait: {fileID: 0}
    text: "Hindi lamang salita ang naibalik mo, Juan. Isang buong pangungusap \u2014
      at ang tiwala ng iyong ama."
