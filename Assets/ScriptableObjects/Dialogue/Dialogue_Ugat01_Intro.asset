  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 38eca7172864c470fb6cd1ee26d93838, type: 3}
  m_Name: Dialogue_Ugat01_Intro
  m_EditorClassIdentifier: Salinlahi.Runtime::DialogueSO
  lines:
  - speakerName: Tagapagsalaysay
    portrait: {fileID: 0}
    text: Noong unang panahon, isinusulat ng ating mga ninuno ang kanilang mga alaala
      sa Baybayin.
  - speakerName: Tagapagsalaysay
    portrait: {fileID: 0}
    text: Ngunit dumating ang Paglimot, at unti-unting kinain nito ang mga alaala
      ng pamilya ni Juan.
  - speakerName: Juan
    portrait: {fileID: 0}
    text: Hindi ko na maalala ang mukha nina Ina at Ama...
  - speakerName: Tagapagsalaysay
    portrait: {fileID: 0}
    text: 'Sa bawat titik ng Baybayin na matututunan mo, isang alaala ang maibabalik.
      Simulan natin sa dalawang salitang pinakamalapit sa puso: INA at AMA.'
