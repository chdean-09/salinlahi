  m_Script: {fileID: 11500000, guid: 38eca7172864c470fb6cd1ee26d93838, type: 3}
  m_Name: Dialogue_Ugat03_Intro
  m_EditorClassIdentifier: Salinlahi.Runtime::DialogueSO
  lines:
  - speakerName: Tagapagsalaysay
    portrait: {fileID: 0}
    text: "Sa lilim ng punong mangga, may naririnig si Juan na tinig \u2014 ang tinig
      ng kanyang ama."
  - speakerName: Juan
    portrait: {fileID: 0}
    text: May sinasabi siya tungkol sa akin. Ngunit hindi ko na maalala ang buong
      pangungusap.
  - speakerName: Tagapagsalaysay
    portrait: {fileID: 0}
    text: 'Hindi sapat ang isang salita ngayon. Buuin mo ang buong pangungusap: balikan
      ang BATA, at hanapin ang TAMA.'
