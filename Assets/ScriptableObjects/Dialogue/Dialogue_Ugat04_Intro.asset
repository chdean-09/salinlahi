  m_Script: {fileID: 11500000, guid: 38eca7172864c470fb6cd1ee26d93838, type: 3}
  m_Name: Dialogue_Ugat04_Intro
  m_EditorClassIdentifier: Salinlahi.Runtime::DialogueSO
  lines:
  - speakerName: Tagapagsalaysay
    portrait: {fileID: 0}
    text: Humina ang liwanag sa daan pauwi. Kakaunti na lamang ang palatandaan.
  - speakerName: Juan
    portrait: {fileID: 0}
    text: Alam ko ang mga salitang ito. Nabakas ko na sila noon.
  - speakerName: Tagapagsalaysay
    portrait: {fileID: 0}
    text: Kaya nga inaalis ko na ang ilang gabay. Kung tunay mong naaalala sina INA
      at AMA, mababakas mo sila kahit walang tulong.
