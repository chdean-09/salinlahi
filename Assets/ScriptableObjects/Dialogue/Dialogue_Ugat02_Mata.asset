  m_Name: Dialogue_Ugat02_Mata
  m_EditorClassIdentifier: Salinlahi.Runtime::DialogueSO
  lines:
  - speakerName: Tagapagsalaysay
    portrait: {fileID: 0}
    text: "MATA \u2014 ang nakakikita at nakaaalala. Binubuo ito ng dalawang titik:
      MA at TA."
  - speakerName: Tagapagsalaysay
    portrait: {fileID: 0}
    text: Bakasin mo ang bawat titik upang muling makita ang nakaraan.
