  m_Script: {fileID: 11500000, guid: 38eca7172864c470fb6cd1ee26d93838, type: 3}
  m_Name: Dialogue_Ugat02_Intro
  m_EditorClassIdentifier: Salinlahi.Runtime::DialogueSO
  lines:
  - speakerName: Tagapagsalaysay
    portrait: {fileID: 0}
    text: Bumalik si Juan sa lumang tahanan. May naaninag siyang anino ng isang batang
      naglalaro sa bakuran.
  - speakerName: Juan
    portrait: {fileID: 0}
    text: Kilala ko ang batang iyan... ngunit hindi ko makita ang kanyang mukha.
  - speakerName: Tagapagsalaysay
    portrait: {fileID: 0}
    text: 'Ang Paglimot ay unang kumukuha sa mga mata. Ibalik mo ang dalawang salitang
      magpapakita muli sa iyo: BATA at MATA.'
