  m_Script: {fileID: 11500000, guid: 38eca7172864c470fb6cd1ee26d93838, type: 3}
  m_Name: Dialogue_Ugat05_Mana
  m_EditorClassIdentifier: Salinlahi.Runtime::DialogueSO
  lines:
  - speakerName: Tagapagsalaysay
    portrait: {fileID: 0}
    text: "MANA \u2014 ang minana mula sa nauna, ang ipinapasa sa susunod. Binubuo
      ito ng dalawang titik: MA at NA."
  - speakerName: Tagapagsalaysay
    portrait: {fileID: 0}
    text: Bakasin mo ito upang angkinin ang iyong pamana.
