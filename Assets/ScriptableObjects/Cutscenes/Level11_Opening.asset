  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 70f95914c0af94d7bbb1e9ce7cf6e6a8, type: 3}
  m_Name: Level11_Opening
  m_EditorClassIdentifier: Salinlahi.Runtime::CutsceneSO
  cutsceneId: cutscene.pamana.01.opening
  panels:
  - image: {fileID: 21300000, guid: 002e5a494b91d2f4b917277ce65f614b, type: 3}
    text: 'Beyond the village, Juan discovers a chamber built to preserve what came
      before.

      One wall remembers the family gathered around its fire. The
      other remembers the community they built together.

      Between them, an
      empty path waits for whoever will carry their story forward.'
    transitionIn: 0
    transitionDuration: 0
    typewriterSpeed: 0
  - image: {fileID: 21300000, guid: b02db859d4d66e441aeabfe5c1596121, type: 3}
    text: 'When Juan opens the ancient Scroll, its characters rise and turn like
      a living current.

      The words do not ask to be kept behind glass.

      They
      are searching for another voice, another hand, and another generation.'
    transitionIn: 0
    transitionDuration: 0
    typewriterSpeed: 0
  - image: {fileID: 21300000, guid: 6f2b7b70b9df13b4a8acbaeb0705113b, type: 3}
    text: 'Juan understands at last: an inheritance survives only when it is carried
      forward.

      He takes the Scroll in both hands, no longer only searching
      for what was lost.

      He will remember it, live it, and pass it on.'
    transitionIn: 0
    transitionDuration: 0
    typewriterSpeed: 0
  defaultTransition: 1
  defaultTransitionDuration: 0.5
  defaultTypewriterSpeed: 30
