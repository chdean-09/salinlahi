MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 70f95914c0af94d7bbb1e9ce7cf6e6a8, type: 3}
  m_Name: Level1_Opening
  m_EditorClassIdentifier: Salinlahi.Runtime::CutsceneSO
  cutsceneId: cutscene.ugat.01.opening
  panels:
  - image: {fileID: 5389463314004490309, guid: f7f34e4d49a300b44b66bbbea13dd418, type: 3}
    text: 'Juan comes home to a house that is still alive.

      The fire is warm,
      the pot is steaming, a mat sits half-woven with the needle beside it.

      But
      no one is there, and he cannot remember the faces of the people who should
      be.'
    transitionIn: 0
    transitionDuration: 0
    typewriterSpeed: 0
  - image: {fileID: -2546248128727442234, guid: 6809814cd52f1b044a0489144d8ec148, type: 3}
    text: 'On the far mat the Living Scroll lies open and glowing, and every name
      his family had is written on it.

      The characters are lifting off the
      page one by one and going grey.

      Something is erasing them, and when
      a name is gone, so is the person.'
    transitionIn: 0
    transitionDuration: 0
    typewriterSpeed: 0
  - image: {fileID: -1878241172454444111, guid: 4db070788bebd06448efb41d80fcd204, type: 3}
    text: "Juan reaches for the Scroll and it answers him \u2014 he is the Salinlahi,
      the one who inherits what the generations before him left behind.\nOne faint
      letter waits on the page for a hand to trace it.\nHe is the last person who
      can still draw them back."
    transitionIn: 0
    transitionDuration: 0
    typewriterSpeed: 0
  defaultTransition: 1
  defaultTransitionDuration: 0.5
  defaultTypewriterSpeed: 30
