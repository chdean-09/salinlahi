--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 70f95914c0af94d7bbb1e9ce7cf6e6a8, type: 3}
  m_Name: Level1_Opening
  m_EditorClassIdentifier: Salinlahi.Runtime::CutsceneSO
  cutsceneId: cutscene.ugat.01.opening
  panels:
  - image: {fileID: 21300000, guid: f80286a6fc7643e8bbae8dd715fe5a4d, type: 3}
    text: "Juan comes home to a house that is still alive.\nThe fire is warm, the
      pot is steaming, a mat sits half-woven with the needle beside it.\nBut no one
      is there, and he cannot remember the faces of the people who should be."
    transitionIn: 0
    transitionDuration: 0
    typewriterSpeed: 0
  - image: {fileID: 21300000, guid: c76c9bc84db94e168cc7ebed0afc85e9, type: 3}
    text: "On the far mat the Living Scroll lies open and glowing, and every name
      his family had is written on it.\nThe characters are lifting off the page one
      by one and going grey.\nSomething is erasing them, and when a name is gone,
      so is the person."
    transitionIn: 0
    transitionDuration: 0
    typewriterSpeed: 0
  - image: {fileID: 21300000, guid: 04601a95f2434a6da999866ab9a6d4be, type: 3}
    text: "Juan reaches for the Scroll and it answers him \u2014 he is the Salinlahi,
      the one who inherits what the generations before him left behind.\nOne faint
      letter waits on the page for a hand to trace it.\nHe is the last person who
      can still draw them back."
    transitionIn: 0
    transitionDuration: 0
    typewriterSpeed: 0
  defaultTransition: 1
  defaultTransitionDuration: 0.5
  defaultTypewriterSpeed: 30
