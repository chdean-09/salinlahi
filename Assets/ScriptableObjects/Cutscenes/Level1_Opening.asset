MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 70f95914c0af94d7bbb1e9ce7cf6e6a8, type: 3}
  m_Name: Level1_Opening
  m_EditorClassIdentifier: Salinlahi.Runtime::CutsceneSO
  cutsceneId: cutscene.ugat.01.opening
  panels:
  - image: {fileID: 5389463314004490309, guid: f7f34e4d49a300b44b66bbbea13dd418, type: 3}
    text: 'Umuwi si Juan sa bahay na tila buhay pa.

      Mainit ang apoy, umuusok ang palayok, at kalahati pa lang ang pagkakabuo sa
      banig na may karayom sa tabi.

      Pero walang tao roon, at hindi na niya maalala ang mga mukha ng mga dapat
      naroon.'
    transitionIn: 0
    transitionDuration: 0
    typewriterSpeed: 0
  - image: {fileID: -2546248128727442234, guid: 6809814cd52f1b044a0489144d8ec148, type: 3}
    text: 'Nakaharap at kumikinang ang Buhay na Kasulatan sa dulong banig. Nakasulat doon
      ang lahat ng pangalang minana ng pamilya niya.

      Isa-isang umaangat sa pahina ang mga titik at namumuti.

      May bumubura sa mga ito; kapag nabura ang isang pangalan, nawawala rin ang
      taong nagtataglay nito.'
    transitionIn: 0
    transitionDuration: 0
    typewriterSpeed: 0
  - image: {fileID: -1878241172454444111, guid: 4db070788bebd06448efb41d80fcd204, type: 3}
    text: "Iniabot ni Juan ang kamay sa Scroll, at tumugon ito sa kanya. Siya ang
      Salinlahi, ang magmamana ng iniwan ng mga naunang henerasyon.\nMay isang
      maputlang titik sa pahina na naghihintay na masundan ng kamay.\nSiya na lang
      ang makaguguhit muli sa mga ito."
    transitionIn: 0
    transitionDuration: 0
    typewriterSpeed: 0
  defaultTransition: 1
  defaultTransitionDuration: 0.5
  defaultTypewriterSpeed: 30
