  pages:
  - title: El Inquisidor
    body: A corrupted high-ranking friar who ordered the burning of Baybayin manuscripts
      during the Spanish era. He wants to erase the script and the memory of the
      people.
    frames:
    - {fileID: 95172164111334305, guid: f6ede119ad3b6824b9652c0513057a7c, type: 3}
    animationFps: 0
    effect: 0
  - title: Summoning
    body: It paces and summons enemies in waves. Clear them to wear the boss down.
    frames:
    - {fileID: -5875916747654802628, guid: f5e3baeb6ac82454599eb01b299d517e, type: 3}
    - {fileID: -6719877106280894156, guid: f5e3baeb6ac82454599eb01b299d517e, type: 3}
